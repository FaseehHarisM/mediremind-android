<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background">

    <TextView
        android:id="@+id/tvDetailName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medicine Name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDetailDosageType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="500 mg • Tablet"
        android:textSize="16sp"
        android:textColor="@color/secondary_text"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDetailTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reminder Time: 8:00 AM"
        android:textSize="16sp"
        android:textColor="@color/primary_text"
        android:layout_marginBottom="8dp" />
        
    <TextView
        android:id="@+id/tvDetailStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPCOMING"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="@color/warning_background"
        android:textColor="@color/warning"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvDetailNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notes: "
        android:textSize="16sp"
        android:textColor="@color/secondary_text"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnMarkTaken"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mark as Taken"
        android:backgroundTint="@color/success"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delete"
        android:backgroundTint="@color/error"
        android:textColor="@color/white" />

</LinearLayout>
